@model Livro
@{
    ViewData["Title"] = "Cadastrar Livro";
}

<ul class="breadcrumb">
    <li><a href="/Livro">Livros</a></li>
    <li class="breadcrumb-separator">›</li>
    <li>Cadastrar</li>
</ul>

<div class="page-header">
    <div>
        <h1>➕ Cadastrar Livro</h1>
        <p>Adicione um novo livro ao acervo</p>
    </div>
</div>

<div class="card" style="max-width:680px">
    <div class="card-header">📖 Dados do Livro</div>
    <div class="card-body">
        <form method="post" asp-action="Create" asp-controller="Livro">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="Titulo" class="form-label">Título <span class="required">*</span></label>
                <input asp-for="Titulo" class="form-control" placeholder="Ex: Dom Casmurro" />
                <span asp-validation-for="Titulo" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Autor" class="form-label">Autor <span class="required">*</span></label>
                <input asp-for="Autor" class="form-control" placeholder="Ex: Machado de Assis" />
                <span asp-validation-for="Autor" class="field-validation-error"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="AnoPublicacao" class="form-label">Ano de Publicação <span class="required">*</span></label>
                    <input asp-for="AnoPublicacao" class="form-control" type="number" placeholder="@DateTime.Now.Year" />
                    <span asp-validation-for="AnoPublicacao" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CategoriaId" class="form-label">Categoria <span class="required">*</span></label>
                    <select asp-for="CategoriaId" class="form-control" asp-items="ViewBag.Categorias">
                        <option value="">Selecione...</option>
                    </select>
                    <span asp-validation-for="CategoriaId" class="field-validation-error"></span>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">💾 Cadastrar Livro</button>
                <a href="/Livro" class="btn btn-secondary">← Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
