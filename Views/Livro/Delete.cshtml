@model Livro
@{
    ViewData["Title"] = "Excluir Livro";
}

<ul class="breadcrumb">
    <li><a href="/Livro">Livros</a></li>
    <li class="breadcrumb-separator">›</li>
    <li>Excluir</li>
</ul>

<div class="delete-page">
    <div class="delete-wrapper">
        <div class="delete-card">
            <div class="delete-card-top">
                <div class="dct-circle">🗑️</div>
                <div class="dct-title">Excluir Livro</div>
                <div class="dct-desc">
                    Você está prestes a excluir o livro <strong>"@Model.Titulo"</strong>.<br>
                    Esta ação é permanente e não pode ser desfeita.
                </div>
            </div>

            <div class="delete-preview">
                <div class="dp-row">
                    <span class="dp-label">Título</span>
                    <span class="dp-value">@Model.Titulo</span>
                </div>
                <div class="dp-row">
                    <span class="dp-label">Autor</span>
                    <span class="dp-value">@Model.Autor</span>
                </div>
                <div class="dp-row">
                    <span class="dp-label">Ano</span>
                    <span class="dp-value">@Model.AnoPublicacao</span>
                </div>
                <div class="dp-row">
                    <span class="dp-label">Categoria</span>
                    <span class="dp-value">@Model.Categoria?.Nome</span>
                </div>
                <div class="dp-row">
                    <span class="dp-label">Status</span>
                    <span class="dp-value">@Model.ExemplaresDisponiveis/@Model.TotalExemplares disponível/eis</span>
                </div>
            </div>

            <div class="delete-card-warning">
                <span>⚠️</span>
                <span>Todo o histórico de empréstimos deste livro também será removido permanentemente.</span>
            </div>

            <form method="post" asp-action="Delete" asp-controller="Livro" asp-route-id="@Model.Id">
                @Html.AntiForgeryToken()
                <div class="delete-card-actions">
                    <button type="submit" class="btn-delete-confirm">🗑️ Confirmar Exclusão</button>
                    <a href="/Livro/Details/@Model.Id" class="btn-delete-cancel">← Cancelar e Voltar</a>
                </div>
            </form>
        </div>
    </div>
</div>
