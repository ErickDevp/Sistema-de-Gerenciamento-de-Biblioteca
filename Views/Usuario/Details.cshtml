@model Usuario
@{
    ViewData["Title"] = "Detalhes do Usuário";
}

<ul class="breadcrumb">
    <li><a href="/Usuario">Usuários</a></li>
    <li class="breadcrumb-separator">›</li>
    <li>@Model.Nome</li>
</ul>

<div class="page-header">
    <div><h1>Detalhes do Usuário</h1></div>
    <div class="btn-group">
        <a href="/Usuario/Edit/@Model.Id" class="btn btn-warning">✏️ Editar</a>
        <a href="/Usuario" class="btn btn-secondary">← Voltar</a>
    </div>
</div>

<div class="detail-page">
    <div>
        <div class="detail-card">
            <div class="detail-hero">
                @if (!string.IsNullOrEmpty(Model.FotoUrl))
                {
                    <img src="@Model.FotoUrl" alt="@Model.Nome"
                         style="width:56px;height:56px;border-radius:50%;object-fit:cover;border:3px solid rgba(255,255,255,0.3);flex-shrink:0"
                         onerror="this.style.display='none'" />
                }
                else
                {
                    <div class="hero-icon">👤</div>
                }
                <div>
                    <div class="hero-title">@Model.Nome</div>
                    <div class="hero-sub">@Model.Email</div>
                </div>
                @if (Model.Role == "Administrador")
                {
                    <span class="hero-badge admin">👑 Administrador</span>
                }
                else
                {
                    <span class="hero-badge staff">👤 Funcionário</span>
                }
            </div>
            <div class="detail-fields">
                <div class="detail-fields-grid">
                    <div class="detail-field">
                        <div class="df-label">Nome Completo</div>
                        <div class="df-value">@Model.Nome</div>
                    </div>
                    <div class="detail-field">
                        <div class="df-label">E-mail</div>
                        <div class="df-value">@Model.Email</div>
                    </div>
                    <div class="detail-field">
                        <div class="df-label">Cargo</div>
                        <div class="df-value">@Model.Role</div>
                    </div>
                    <div class="detail-field">
                        <div class="df-label">ID do Usuário</div>
                        <div class="df-value">#@Model.Id</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="form-sidebar">
        <div class="detail-actions-card">
            <div class="dac-header">Ações</div>
            <div class="dac-body">
                <a href="/Usuario/Edit/@Model.Id" class="dac-btn warning">✏️ Editar Usuário</a>
                <a href="/Usuario/Delete/@Model.Id" class="dac-btn danger">🗑 Excluir</a>
                <a href="/Usuario" class="dac-btn secondary">← Voltar à Lista</a>
            </div>
        </div>
        <div class="sidebar-card">
            <div class="sidebar-card-header">🔐 Permissões</div>
            <div class="sidebar-card-body">
                @if (Model.Role == "Administrador")
                {
                    <div class="info-item">
                        <span class="info-icon">✅</span>
                        <span class="info-text">Gerenciar usuários</span>
                    </div>
                    <div class="info-item">
                        <span class="info-icon">✅</span>
                        <span class="info-text">Gerenciar livros e categorias</span>
                    </div>
                    <div class="info-item">
                        <span class="info-icon">✅</span>
                        <span class="info-text">Gerenciar empréstimos</span>
                    </div>
                }
                else
                {
                    <div class="info-item">
                        <span class="info-icon">❌</span>
                        <span class="info-text">Gerenciar usuários</span>
                    </div>
                    <div class="info-item">
                        <span class="info-icon">✅</span>
                        <span class="info-text">Gerenciar livros e categorias</span>
                    </div>
                    <div class="info-item">
                        <span class="info-icon">✅</span>
                        <span class="info-text">Gerenciar empréstimos</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
