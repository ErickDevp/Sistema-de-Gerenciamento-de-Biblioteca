@model Usuario
@{
    ViewData["Title"] = "Editar Usuário";
}

<ul class="breadcrumb">
    <li><a href="/Usuario">Usuários</a></li>
    <li class="breadcrumb-separator">›</li>
    <li>Editar</li>
</ul>

<div class="page-header">
    <h1>Editar Usuário</h1>
</div>

<form method="post" asp-action="Edit" asp-controller="Usuario" asp-route-id="@Model.Id">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <input asp-for="SenhaHash" type="hidden" />
    <div class="form-page">
        <div>
            <div class="form-card">
                <div class="form-card-header">
                    <div class="fch-icon blue">👤</div>
                    <div>
                        <div class="fch-title">@Model.Nome</div>
                        <div class="fch-sub">Editando dados do usuário</div>
                    </div>
                </div>
                <div class="form-card-body">
                    <div class="form-section">
                        <div class="form-section-title">Identificação</div>
                        <div class="field">
                            <label asp-for="Nome" class="field-label">Nome Completo <span class="req">*</span></label>
                            <input asp-for="Nome" class="field-input" />
                            <span asp-validation-for="Nome" class="field-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Email" class="field-label">E-mail <span class="req">*</span></label>
                            <input asp-for="Email" class="field-input" type="email" />
                            <span asp-validation-for="Email" class="field-error"></span>
                        </div>
                    </div>
                    <div class="form-section">
                        <div class="form-section-title">Alterar Senha <span style="font-size:0.75rem; font-weight:400; color:#9ca3af; text-transform:none; letter-spacing:0">(opcional)</span></div>
                        <div class="fields-row">
                            <div class="field">
                                <label class="field-label">Nova Senha</label>
                                <input name="NovaSenha" class="field-input" type="password" placeholder="Deixe em branco para manter" />
                                <span class="field-error">@ViewData.ModelState["NovaSenha"]?.Errors.FirstOrDefault()?.ErrorMessage</span>
                            </div>
                            <div class="field">
                                <label class="field-label">Confirmar Nova Senha</label>
                                <input name="ConfirmarSenha" class="field-input" type="password" placeholder="Repita a nova senha" />
                                <span class="field-error">@ViewData.ModelState["ConfirmarSenha"]?.Errors.FirstOrDefault()?.ErrorMessage</span>
                            </div>
                        </div>
                    </div>
                    <div class="form-section">
                        <div class="form-section-title">Permissões</div>
                        <div class="field">
                            <label asp-for="Role" class="field-label">Cargo <span class="req">*</span></label>
                            <select asp-for="Role" class="field-input">
                                <option value="Funcionario">👤 Funcionário</option>
                                <option value="Administrador">👑 Administrador</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-section">
                        <div class="form-section-title">Foto de Perfil</div>
                        <div class="field">
                            <label asp-for="FotoUrl" class="field-label">URL da Foto <span class="field-hint">(opcional)</span></label>
                            <input asp-for="FotoUrl" class="field-input" placeholder="https://..." oninput="previewFoto(this.value)" />
                            <span asp-validation-for="FotoUrl" class="field-error"></span>
                        </div>
                        <div id="fotoPreview" style="margin-top:10px; @(string.IsNullOrEmpty(Model.FotoUrl) ? "display:none" : "display:flex"); align-items:center; gap:12px">
                            <img id="fotoImg" src="@Model.FotoUrl" alt="Foto"
                                 style="width:56px;height:56px;border-radius:50%;object-fit:cover;border:2px solid #e5e7eb;box-shadow:0 2px 8px rgba(0,0,0,0.1)"
                                 onerror="document.getElementById('fotoPreview').style.display='none'" />
                            <span style="font-size:0.82rem;color:#6b7280">Foto atual do perfil</span>
                        </div>
                    </div>
                </div>
                <div class="form-footer">
                    <button type="submit" class="btn-submit">💾 Salvar Alterações</button>
                    <a href="/Usuario/Details/@Model.Id" class="btn-cancel">← Cancelar</a>
                </div>
            </div>
        </div>
        <div class="form-sidebar">
            <div class="sidebar-card">
                <div class="sidebar-card-header">📋 Registro</div>
                <div class="sidebar-card-body">
                    <div class="info-item">
                        <span class="info-icon">🆔</span>
                        <span class="info-text">ID: <strong>#@Model.Id</strong></span>
                    </div>
                    <div class="info-item">
                        <span class="info-icon">@(Model.Role == "Administrador" ? "👑" : "👤")</span>
                        <span class="info-text">Cargo atual: <strong>@Model.Role</strong></span>
                    </div>
                </div>
            </div>
            <div class="info-box info">
                <span class="ib-icon">🔒</span>
                <span>Deixe os campos de senha <strong>em branco</strong> para manter a senha atual.</span>
            </div>
        </div>
    </div>
</form>

<script>
function previewFoto(url) {
    const preview = document.getElementById('fotoPreview');
    const img = document.getElementById('fotoImg');
    if (url && url.startsWith('http')) {
        img.src = url;
        preview.style.display = 'flex';
        img.onerror = () => { preview.style.display = 'none'; };
    } else {
        preview.style.display = 'none';
    }
}
</script>
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
