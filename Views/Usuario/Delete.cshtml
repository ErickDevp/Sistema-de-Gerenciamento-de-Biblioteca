@model Usuario
@{
    ViewData["Title"] = "Excluir Usuário";
}

<ul class="breadcrumb">
    <li><a href="/Usuario">Usuários</a></li>
    <li class="breadcrumb-separator">›</li>
    <li>Excluir</li>
</ul>

<div class="delete-page">
    <div class="delete-wrapper">
        <div class="delete-card">
            <div class="delete-card-top">
                <div class="dct-circle">👤</div>
                <div class="dct-title">Excluir Usuário</div>
                <div class="dct-desc">
                    Você está prestes a excluir o usuário <strong>"@Model.Nome"</strong>.<br>
                    Ele não poderá mais acessar o sistema após a exclusão.
                </div>
            </div>

            <div class="delete-preview">
                <div class="dp-row">
                    <span class="dp-label">Nome</span>
                    <span class="dp-value">@Model.Nome</span>
                </div>
                <div class="dp-row">
                    <span class="dp-label">E-mail</span>
                    <span class="dp-value">@Model.Email</span>
                </div>
                <div class="dp-row">
                    <span class="dp-label">Cargo</span>
                    <span class="dp-value">@(Model.Role == "Administrador" ? "👑 Administrador" : "👤 Funcionário")</span>
                </div>
            </div>

            <div class="delete-card-warning">
                <span>⚠️</span>
                <span>Esta ação é permanente. O usuário será removido imediatamente do sistema.</span>
            </div>

            <form method="post" asp-action="Delete" asp-controller="Usuario" asp-route-id="@Model.Id">
                @Html.AntiForgeryToken()
                <div class="delete-card-actions">
                    <button type="submit" class="btn-delete-confirm">🗑️ Confirmar Exclusão</button>
                    <a href="/Usuario/Details/@Model.Id" class="btn-delete-cancel">← Cancelar e Voltar</a>
                </div>
            </form>
        </div>
    </div>
</div>
