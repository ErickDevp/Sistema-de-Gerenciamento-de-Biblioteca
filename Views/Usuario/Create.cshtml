@model Usuario
@{
    ViewData["Title"] = "Novo Usuário";
}

<ul class="breadcrumb">
    <li><a href="/Usuario">Usuários</a></li>
    <li class="breadcrumb-separator">›</li>
    <li>Cadastrar</li>
</ul>

<div class="page-header">
    <h1>Novo Usuário</h1>
</div>

<form method="post" asp-action="Create" asp-controller="Usuario">
    @Html.AntiForgeryToken()
    <div class="form-page">
        <div>
            <div class="form-card">
                <div class="form-card-header">
                    <div class="fch-icon blue">👤</div>
                    <div>
                        <div class="fch-title">Dados do Usuário</div>
                        <div class="fch-sub">Preencha as informações do novo usuário</div>
                    </div>
                </div>
                <div class="form-card-body">
                    <div class="form-section">
                        <div class="form-section-title">Identificação</div>
                        <div class="field">
                            <label asp-for="Nome" class="field-label">Nome Completo <span class="req">*</span></label>
                            <input asp-for="Nome" class="field-input" placeholder="Nome completo" />
                            <span asp-validation-for="Nome" class="field-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Email" class="field-label">E-mail <span class="req">*</span></label>
                            <input asp-for="Email" class="field-input" type="email" placeholder="email@exemplo.com" />
                            <span asp-validation-for="Email" class="field-error"></span>
                        </div>
                    </div>
                    <div class="form-section">
                        <div class="form-section-title">Segurança</div>
                        <div class="fields-row">
                            <div class="field">
                                <label class="field-label">Senha <span class="req">*</span></label>
                                <input name="Senha" class="field-input" type="password" placeholder="Mínimo 6 caracteres" />
                                <span class="field-error">@ViewData.ModelState["Senha"]?.Errors.FirstOrDefault()?.ErrorMessage</span>
                            </div>
                            <div class="field">
                                <label class="field-label">Confirmar Senha <span class="req">*</span></label>
                                <input name="ConfirmarSenha" class="field-input" type="password" placeholder="Repita a senha" />
                                <span class="field-error">@ViewData.ModelState["ConfirmarSenha"]?.Errors.FirstOrDefault()?.ErrorMessage</span>
                            </div>
                        </div>
                    </div>
                    <div class="form-section">
                        <div class="form-section-title">Permissões</div>
                        <div class="field">
                            <label asp-for="Role" class="field-label">Cargo <span class="req">*</span></label>
                            <select asp-for="Role" class="field-input">
                                <option value="Funcionario">👤 Funcionário</option>
                                <option value="Administrador">👑 Administrador</option>
                            </select>
                            <span asp-validation-for="Role" class="field-error"></span>
                        </div>
                    </div>
                    <div class="form-section">
                        <div class="form-section-title">Foto de Perfil</div>
                        <div class="field">
                            <label asp-for="FotoUrl" class="field-label">URL da Foto <span class="field-hint">(opcional)</span></label>
                            <input asp-for="FotoUrl" class="field-input" placeholder="https://..." id="fotoInput" oninput="previewFoto(this.value)" />
                            <span asp-validation-for="FotoUrl" class="field-error"></span>
                            <div class="field-desc">A foto aparecerá no canto superior direito ao logar.</div>
                        </div>
                        <div id="fotoPreview" style="display:none; margin-top:10px; display:flex; align-items:center; gap:12px">
                            <img id="fotoImg" src="" alt="Preview" style="width:56px;height:56px;border-radius:50%;object-fit:cover;border:2px solid #e5e7eb;box-shadow:0 2px 8px rgba(0,0,0,0.1)" onerror="document.getElementById('fotoPreview').style.display='none'" />
                            <span style="font-size:0.82rem;color:#6b7280">Pré-visualização da foto</span>
                        </div>
                    </div>
                </div>
                <div class="form-footer">
                    <button type="submit" class="btn-submit">💾 Cadastrar Usuário</button>
                    <a href="/Usuario" class="btn-cancel">← Cancelar</a>
                </div>
            </div>
        </div>
        <div class="form-sidebar">
            <div class="sidebar-card">
                <div class="sidebar-card-header">🔐 Cargos</div>
                <div class="sidebar-card-body">
                    <div class="info-item">
                        <span class="info-icon">👑</span>
                        <span class="info-text"><strong>Administrador</strong> — acesso total, incluindo gerenciamento de usuários.</span>
                    </div>
                    <div class="info-item">
                        <span class="info-icon">👤</span>
                        <span class="info-text"><strong>Funcionário</strong> — pode gerenciar livros, categorias e empréstimos.</span>
                    </div>
                </div>
            </div>
            <div class="info-box info">
                <span class="ib-icon">🔒</span>
                <span>A senha é armazenada de forma <strong>criptografada</strong> e não pode ser recuperada.</span>
            </div>
        </div>
    </div>
</form>

<script>
function previewFoto(url) {
    const preview = document.getElementById('fotoPreview');
    const img = document.getElementById('fotoImg');
    if (url && url.startsWith('http')) {
        img.src = url;
        preview.style.display = 'flex';
        img.onerror = () => { preview.style.display = 'none'; };
    } else {
        preview.style.display = 'none';
    }
}
</script>
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
