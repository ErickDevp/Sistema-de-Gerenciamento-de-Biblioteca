@model Usuario
@{
    ViewData["Title"] = "Novo Usuário";
}

<ul class="breadcrumb">
    <li><a href="/Usuario">Usuários</a></li>
    <li class="breadcrumb-separator">›</li>
    <li>Cadastrar</li>
</ul>

<div class="page-header">
    <h1>➕ Novo Usuário</h1>
</div>

<div class="card" style="max-width:600px">
    <div class="card-header">👤 Dados do Usuário</div>
    <div class="card-body">
        <form method="post" asp-action="Create" asp-controller="Usuario">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="Nome" class="form-label">Nome <span class="required">*</span></label>
                <input asp-for="Nome" class="form-control" placeholder="Nome completo" />
                <span asp-validation-for="Nome" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email" class="form-label">E-mail <span class="required">*</span></label>
                <input asp-for="Email" class="form-control" placeholder="email@exemplo.com" type="email" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Senha <span class="required">*</span></label>
                    <input name="Senha" class="form-control" type="password" placeholder="Mínimo 6 caracteres" />
                    <span class="field-validation-error">@ViewData.ModelState["Senha"]?.Errors.FirstOrDefault()?.ErrorMessage</span>
                </div>

                <div class="form-group">
                    <label class="form-label">Confirmar Senha <span class="required">*</span></label>
                    <input name="ConfirmarSenha" class="form-control" type="password" placeholder="Repita a senha" />
                    <span class="field-validation-error">@ViewData.ModelState["ConfirmarSenha"]?.Errors.FirstOrDefault()?.ErrorMessage</span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Role" class="form-label">Cargo <span class="required">*</span></label>
                <select asp-for="Role" class="form-control">
                    <option value="Funcionario">👤 Funcionário</option>
                    <option value="Administrador">👑 Administrador</option>
                </select>
                <span asp-validation-for="Role" class="field-validation-error"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">💾 Cadastrar Usuário</button>
                <a href="/Usuario" class="btn btn-secondary">← Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
