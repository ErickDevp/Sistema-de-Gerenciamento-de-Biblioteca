@model Categoria
@{
    ViewData["Title"] = "Excluir Categoria";
}

<ul class="breadcrumb">
    <li><a href="/Categoria">Categorias</a></li>
    <li class="breadcrumb-separator">›</li>
    <li>Excluir</li>
</ul>

<div class="delete-page">
    <div class="delete-wrapper">
        <div class="delete-card">
            @if (Model.Livros.Any())
            {
                <div class="delete-card-top">
                    <div class="dct-circle" style="background:#fef3c7">🚫</div>
                    <div class="dct-title">Não é possível excluir</div>
                    <div class="dct-desc">
                        A categoria <strong>"@Model.Nome"</strong> possui livros associados e não pode ser excluída.
                    </div>
                </div>
                <div class="delete-preview">
                    <div class="dp-row">
                        <span class="dp-label">Categoria</span>
                        <span class="dp-value">@Model.Nome</span>
                    </div>
                    <div class="dp-row">
                        <span class="dp-label">Livros Associados</span>
                        <span class="dp-value" style="color:#dc2626">@Model.Livros.Count livro(s)</span>
                    </div>
                </div>
                <div class="delete-card-warning">
                    <span>💡</span>
                    <span>Remova ou reclassifique todos os livros desta categoria antes de excluí-la.</span>
                </div>
                <div class="delete-card-actions">
                    <a href="/Livro?categoriaId=@Model.Id" class="btn-delete-confirm" style="background:#d97706; text-decoration:none; display:flex; align-items:center; justify-content:center; gap:8px">📚 Ver Livros desta Categoria</a>
                    <a href="/Categoria" class="btn-delete-cancel">← Voltar à Lista</a>
                </div>
            }
            else
            {
                <div class="delete-card-top">
                    <div class="dct-circle">🗑️</div>
                    <div class="dct-title">Excluir Categoria</div>
                    <div class="dct-desc">
                        Você está prestes a excluir a categoria <strong>"@Model.Nome"</strong>.<br>
                        Esta ação é permanente e não pode ser desfeita.
                    </div>
                </div>
                <div class="delete-preview">
                    <div class="dp-row">
                        <span class="dp-label">Nome</span>
                        <span class="dp-value">@Model.Nome</span>
                    </div>
                    <div class="dp-row">
                        <span class="dp-label">Livros Associados</span>
                        <span class="dp-value">Nenhum</span>
                    </div>
                </div>
                <form method="post" asp-action="Delete" asp-controller="Categoria" asp-route-id="@Model.Id">
                    @Html.AntiForgeryToken()
                    <div class="delete-card-actions">
                        <button type="submit" class="btn-delete-confirm">🗑️ Confirmar Exclusão</button>
                        <a href="/Categoria" class="btn-delete-cancel">← Cancelar e Voltar</a>
                    </div>
                </form>
            }
        </div>
    </div>
</div>
