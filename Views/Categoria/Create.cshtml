@model Categoria
@{
    ViewData["Title"] = "Nova Categoria";
}

<ul class="breadcrumb">
    <li><a href="/Categoria">Categorias</a></li>
    <li class="breadcrumb-separator">›</li>
    <li>Cadastrar</li>
</ul>

<div class="page-header">
    <h1>➕ Nova Categoria</h1>
</div>

<div class="card" style="max-width:500px">
    <div class="card-header">🏷️ Dados da Categoria</div>
    <div class="card-body">
        <form method="post" asp-action="Create" asp-controller="Categoria">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="Nome" class="form-label">Nome <span class="required">*</span></label>
                <input asp-for="Nome" class="form-control" placeholder="Ex: Ficção Científica" />
                <span asp-validation-for="Nome" class="field-validation-error"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">💾 Cadastrar</button>
                <a href="/Categoria" class="btn btn-secondary">← Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
