@model Categoria
@{
    ViewData["Title"] = "Nova Categoria";
}

<ul class="breadcrumb">
    <li><a href="/Categoria">Categorias</a></li>
    <li class="breadcrumb-separator">›</li>
    <li>Cadastrar</li>
</ul>

<div class="page-header">
    <h1>Nova Categoria</h1>
</div>

<form method="post" asp-action="Create" asp-controller="Categoria">
    @Html.AntiForgeryToken()
    <div class="form-page">
        <div>
            <div class="form-card">
                <div class="form-card-header">
                    <div class="fch-icon orange">🏷️</div>
                    <div>
                        <div class="fch-title">Dados da Categoria</div>
                        <div class="fch-sub">Defina o nome da nova categoria</div>
                    </div>
                </div>
                <div class="form-card-body">
                    <div class="field">
                        <label asp-for="Nome" class="field-label">Nome da Categoria <span class="req">*</span></label>
                        <input asp-for="Nome" class="field-input" placeholder="Ex: Ficção Científica" />
                        <span asp-validation-for="Nome" class="field-error"></span>
                    </div>
                </div>
                <div class="form-footer">
                    <button type="submit" class="btn-submit">💾 Cadastrar</button>
                    <a href="/Categoria" class="btn-cancel">← Cancelar</a>
                </div>
            </div>
        </div>
        <div class="form-sidebar">
            <div class="info-box info">
                <span class="ib-icon">💡</span>
                <span>Categorias ajudam a organizar o acervo e facilitar buscas. Escolha nomes <strong>claros e objetivos</strong>.</span>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
