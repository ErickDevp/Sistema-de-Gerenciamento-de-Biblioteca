@model Categoria
@{
    ViewData["Title"] = "Detalhes da Categoria";
}

<ul class="breadcrumb">
    <li><a href="/Categoria">Categorias</a></li>
    <li class="breadcrumb-separator">›</li>
    <li>@Model.Nome</li>
</ul>

<div class="page-header">
    <div><h1>@Model.Nome</h1></div>
    <div class="btn-group">
        <a href="/Categoria/Edit/@Model.Id" class="btn btn-warning">✏️ Editar</a>
        <a href="/Categoria" class="btn btn-secondary">← Voltar</a>
    </div>
</div>

<div class="detail-page">
    <div>
        <div class="detail-card">
            <div class="detail-hero">
                <div class="hero-icon">🏷️</div>
                <div>
                    <div class="hero-title">@Model.Nome</div>
                    <div class="hero-sub">@Model.Livros.Count livro(s) nesta categoria</div>
                </div>
            </div>

            @if (Model.Livros.Any())
            {
                <div class="detail-section">
                    <div class="detail-section-title">Livros desta Categoria</div>
                    <div class="table-wrapper">
                        <table>
                            <thead>
                                <tr>
                                    <th>Título</th>
                                    <th>Autor</th>
                                    <th>Ano</th>
                                    <th>Disponível</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var livro in Model.Livros)
                                {
                                    <tr>
                                        <td><a href="/Livro/Details/@livro.Id" style="color:#2563a8">@livro.Titulo</a></td>
                                        <td>@livro.Autor</td>
                                        <td>@livro.AnoPublicacao</td>
                                        <td>
                                            @{ var dC = livro.Exemplares.Count(e => e.Disponivel); }
                                            @if (dC > 0)
                                            { <span class="badge badge-success">@dC disp.</span> }
                                            else
                                            { <span class="badge badge-danger">0 disp.</span> }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="detail-fields">
                    <div class="empty-state">
                        <div class="empty-icon">📚</div>
                        <h3>Nenhum livro nesta categoria</h3>
                        <p>Cadastre livros e associe a esta categoria.</p>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="form-sidebar">
        <div class="detail-actions-card">
            <div class="dac-header">Ações</div>
            <div class="dac-body">
                <a href="/Categoria/Edit/@Model.Id" class="dac-btn warning">✏️ Editar Categoria</a>
                <a href="/Livro/Create" class="dac-btn success">➕ Novo Livro</a>
                <a href="/Categoria/Delete/@Model.Id" class="dac-btn danger">🗑 Excluir</a>
                <a href="/Categoria" class="dac-btn secondary">← Voltar à Lista</a>
            </div>
        </div>
        <div class="sidebar-card">
            <div class="sidebar-card-header">📊 Estatísticas</div>
            <div class="sidebar-card-body">
                <div class="info-item">
                    <span class="info-icon">📚</span>
                    <span class="info-text">Total: <strong>@Model.Livros.Count livro(s)</strong></span>
                </div>
                <div class="info-item">
                    <span class="info-icon">✅</span>
                    <span class="info-text">Disponíveis: <strong>@Model.Livros.Sum(l => l.Exemplares.Count(e => e.Disponivel))</strong></span>
                </div>
                <div class="info-item">
                    <span class="info-icon">📤</span>
                    <span class="info-text">Emprestados: <strong>@Model.Livros.Sum(l => l.Exemplares.Count(e => !e.Disponivel))</strong></span>
                </div>
            </div>
        </div>
    </div>
</div>
