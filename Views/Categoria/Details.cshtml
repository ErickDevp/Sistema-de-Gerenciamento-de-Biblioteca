@model Categoria
@{
    ViewData["Title"] = "Detalhes da Categoria";
}

<ul class="breadcrumb">
    <li><a href="/Categoria">Categorias</a></li>
    <li class="breadcrumb-separator">›</li>
    <li>Detalhes</li>
</ul>

<div class="page-header">
    <h1>👁️ @Model.Nome</h1>
    <div class="btn-group">
        <a href="/Categoria/Edit/@Model.Id" class="btn btn-warning">✏️ Editar</a>
        <a href="/Categoria" class="btn btn-secondary">← Voltar</a>
    </div>
</div>

<div class="card" style="max-width:700px">
    <div class="card-header">🏷️ Categoria: @Model.Nome</div>
    <div class="card-body">
        <div class="detail-item" style="margin-bottom:20px">
            <label>Total de Livros</label>
            <p>@Model.Livros.Count livro(s)</p>
        </div>

        @if (Model.Livros.Any())
        {
            <h4 style="font-size:0.9rem; margin-bottom:12px; color:#1a3a5c">Livros desta categoria</h4>
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Título</th>
                            <th>Autor</th>
                            <th>Ano</th>
                            <th>Disponível</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var livro in Model.Livros)
                        {
                            <tr>
                                <td><a href="/Livro/Details/@livro.Id" style="color:#2563a8">@livro.Titulo</a></td>
                                <td>@livro.Autor</td>
                                <td>@livro.AnoPublicacao</td>
                                <td>
                                    @if (livro.Disponivel)
                                    {
                                        <span class="badge badge-success">Sim</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">Não</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
