@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Biblioteca</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>
<div class="login-page">
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <div class="login-logo">📚</div>
                <h1>Biblioteca</h1>
                <p>Sistema de Gerenciamento de Biblioteca</p>
            </div>

            <div class="login-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        ❌ @Html.ValidationSummary(false, null, new { @class = "" })
                    </div>
                }

                <form method="post" asp-action="Login" asp-controller="Auth">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label asp-for="Email" class="form-label">E-mail</label>
                        <input asp-for="Email" class="form-control" placeholder="seu@email.com" autocomplete="email" />
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Senha" class="form-label">Senha</label>
                        <input asp-for="Senha" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                        <span asp-validation-for="Senha" class="field-validation-error"></span>
                    </div>

                    <button type="submit" class="btn-login">Entrar no Sistema</button>
                </form>
            </div>

            <div class="login-footer">
                <p>Biblioteca &copy; @DateTime.Now.Year</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
</body>
</html>
