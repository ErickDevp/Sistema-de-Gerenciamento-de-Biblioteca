@model EmprestimoViewModel
@{
    ViewData["Title"] = "Novo Empréstimo";
}

<ul class="breadcrumb">
    <li><a href="/Emprestimo">Empréstimos</a></li>
    <li class="breadcrumb-separator">›</li>
    <li>Novo</li>
</ul>

<div class="page-header">
    <div>
        <h1>Registrar Empréstimo</h1>
        <p>Preencha os dados para registrar um novo empréstimo</p>
    </div>
</div>

<form method="post" asp-action="Create" asp-controller="Emprestimo">
    @Html.AntiForgeryToken()
    <div class="form-page">
        <div>
            <div class="form-card">
                <div class="form-card-header">
                    <div class="fch-icon purple">📋</div>
                    <div>
                        <div class="fch-title">Dados do Empréstimo</div>
                        <div class="fch-sub">Informe o livro, leitor e prazo</div>
                    </div>
                </div>
                <div class="form-card-body">
                    <div class="form-section">
                        <div class="form-section-title">Livro</div>
                        <div class="field">
                            <label asp-for="LivroId" class="field-label">Livro Disponível <span class="req">*</span></label>
                            <select asp-for="LivroId" class="field-input" asp-items="Model.LivrosDisponiveis">
                                <option value="">Selecione um livro disponível...</option>
                            </select>
                            <span asp-validation-for="LivroId" class="field-error"></span>
                            <div class="field-desc">Apenas livros com status "Disponível" são exibidos.</div>
                        </div>
                    </div>
                    <div class="form-section">
                        <div class="form-section-title">Leitor</div>
                        <div class="field">
                            <label asp-for="LeitorId" class="field-label">Leitor <span class="req">*</span></label>
                            <select asp-for="LeitorId" class="field-input" asp-items="Model.Leitores">
                                <option value="">Selecione um leitor...</option>
                            </select>
                            <span asp-validation-for="LeitorId" class="field-error"></span>
                            <div class="field-desc">
                                Leitor não cadastrado? <a href="/Leitor/Create" style="color:#2563a8">Cadastrar agora →</a>
                            </div>
                        </div>
                    </div>
                    <div class="form-section">
                        <div class="form-section-title">Prazo</div>
                        <div class="field">
                            <label asp-for="DataPrevistaDevolucao" class="field-label">Data Prevista de Devolução <span class="req">*</span></label>
                            <input asp-for="DataPrevistaDevolucao" class="field-input" type="date"
                                   id="dataDevInput"
                                   value="@Model.DataPrevistaDevolucao.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="DataPrevistaDevolucao" class="field-error"></span>
                            <span id="dataDevErro" class="field-error" style="display:none">
                                ⚠ A data de devolução deve ser posterior à data de hoje.
                            </span>
                            <div class="field-desc">Padrão: 14 dias a partir de hoje.</div>
                        </div>
                    </div>
                </div>
                <div class="form-footer">
                    <button type="submit" class="btn-submit">📋 Registrar Empréstimo</button>
                    <a href="/Emprestimo" class="btn-cancel">← Cancelar</a>
                </div>
            </div>
        </div>
        <div class="form-sidebar">
            <div class="sidebar-card">
                <div class="sidebar-card-header">ℹ️ Como funciona</div>
                <div class="sidebar-card-body">
                    <div class="info-item"><span class="info-icon">1️⃣</span><span class="info-text">Selecione o <strong>livro disponível</strong>.</span></div>
                    <div class="info-item"><span class="info-icon">2️⃣</span><span class="info-text">Selecione o <strong>leitor cadastrado</strong>.</span></div>
                    <div class="info-item"><span class="info-icon">3️⃣</span><span class="info-text">Defina a <strong>data de devolução</strong>.</span></div>
                    <div class="info-item"><span class="info-icon">🔒</span><span class="info-text">O livro ficará <strong>indisponível</strong> automaticamente.</span></div>
                </div>
            </div>
            <div class="info-box info">
                <span class="ib-icon">👤</span>
                <span>Só leitores <strong>ativos</strong> aparecem na lista.</span>
            </div>
        </div>
    </div>
</form>

<script>
document.querySelector('form').addEventListener('submit', function(e) {
    var input = document.getElementById('dataDevInput');
    var erro = document.getElementById('dataDevErro');
    var hoje = new Date();
    hoje.setHours(0,0,0,0);
    var data = new Date(input.value);
    if (!input.value || data <= hoje) {
        e.preventDefault();
        input.style.borderColor = '#ef4444';
        input.style.background = '#fff5f5';
        erro.style.display = 'flex';
        input.focus();
    } else {
        input.style.borderColor = '';
        input.style.background = '';
        erro.style.display = 'none';
    }
});
document.getElementById('dataDevInput').addEventListener('input', function() {
    this.style.borderColor = '';
    this.style.background = '';
    document.getElementById('dataDevErro').style.display = 'none';
});
</script>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
