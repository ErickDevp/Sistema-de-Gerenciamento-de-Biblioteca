@{
    ViewData["Title"] = "Erro";
    Layout = "_Layout";
}

<div class="page-header">
    <div>
        <h1>⚠️ Ocorreu um Erro</h1>
        <p>Algo inesperado aconteceu.</p>
    </div>
    <a href="/Home" class="btn btn-primary">🏠 Voltar ao Início</a>
</div>

<div class="card">
    <div class="card-body">
        <div class="empty-state">
            <div class="empty-icon">😕</div>
