@model Biblioteca.ViewModels.DashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";

    // Serialização segura para JavaScript (evita problemas de encoding/aspas)
    var jsonOpts = new JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
    var mesesJson          = JsonSerializer.Serialize(Model.Meses,              jsonOpts);
    var emprestimosMesJson = JsonSerializer.Serialize(Model.EmprestimosPorMes,  jsonOpts);
    var devolucoesMesJson  = JsonSerializer.Serialize(Model.DevolucoesPorMes,   jsonOpts);
    var categoriasJson     = JsonSerializer.Serialize(Model.Categorias,         jsonOpts);
    var livrosCategJson    = JsonSerializer.Serialize(Model.LivrosPorCategoria, jsonOpts);
}

<div class="page-header">
    <div>
        <h1>📊 Dashboard</h1>
        <p>Visão geral do sistema de biblioteca</p>
    </div>
    <a href="/Emprestimo/Create" class="btn btn-primary">➕ Novo Empréstimo</a>
</div>

<!-- ESTATÍSTICAS -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon blue">📚</div>
        <div class="stat-info">
            <div class="stat-value">@ViewBag.TotalLivros</div>
            <div class="stat-label">Total de Livros</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon green">✅</div>
        <div class="stat-info">
            <div class="stat-value">@ViewBag.LivrosDisponiveis</div>
            <div class="stat-label">Disponíveis</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon orange">📤</div>
        <div class="stat-info">
            <div class="stat-value">@ViewBag.LivrosEmprestados</div>
            <div class="stat-label">Emprestados</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon red">⚠️</div>
        <div class="stat-info">
            <div class="stat-value">@ViewBag.EmprestimosAtrasados</div>
            <div class="stat-label">Atrasados</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon purple">🏷️</div>
        <div class="stat-info">
            <div class="stat-value">@ViewBag.TotalCategorias</div>
            <div class="stat-label">Categorias</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon teal">👤</div>
        <div class="stat-info">
            <div class="stat-value">@ViewBag.TotalLeitores</div>
            <div class="stat-label">Leitores Ativos</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon purple">👥</div>
        <div class="stat-info">
            <div class="stat-value">@ViewBag.TotalUsuarios</div>
            <div class="stat-label">Usuários</div>
        </div>
    </div>
</div>

<!-- ALERTAS -->
@if ((int)ViewBag.EmprestimosAtrasados > 0)
{
    <div class="alert alert-warning">
        ⚠️ Existem <strong>@ViewBag.EmprestimosAtrasados empréstimo(s) atrasado(s)</strong>.
        <a href="/Emprestimo" style="margin-left:8px; color:inherit; font-weight:600;">Ver todos →</a>
    </div>
}

<!-- ── GRÁFICOS ─────────────────────────────────────────────────────────── -->
<div class="dashboard-charts-grid">

    <!-- Gráfico de Barras: Empréstimos x Devoluções por Mês -->
    <div class="chart-card chart-card--wide">
        <div class="card-header">
            📈 Empréstimos x Devoluções por Mês
        </div>
        <div class="card-body">
            @if (!Model.EmprestimosPorMes.Any(v => v > 0) && !Model.DevolucoesPorMes.Any(v => v > 0))
            {
                <div class="chart-empty-state">
                    <span class="chart-empty-icon">📊</span>
                    <p>Nenhum dado de empréstimo nos últimos 6 meses.</p>
                </div>
            }
            else
            {
                <div class="chart-container">
                    <canvas id="emprestimosChart" aria-label="Gráfico de empréstimos e devoluções por mês"></canvas>
                </div>
            }
        </div>
    </div>

    <!-- Gráfico Donut: Livros por Categoria -->
    <div class="chart-card">
        <div class="card-header">
            🍩 Livros por Categoria
        </div>
        <div class="card-body">
            @if (!Model.LivrosPorCategoria.Any(v => v > 0))
            {
                <div class="chart-empty-state">
                    <span class="chart-empty-icon">🏷️</span>
                    <p>Nenhum livro cadastrado com categoria.</p>
                </div>
            }
            else
            {
                <div class="chart-container chart-container--donut">
                    <canvas id="categoriasChart" aria-label="Gráfico de livros por categoria"></canvas>
                </div>
            }
        </div>
    </div>

</div>
<!-- ── FIM GRÁFICOS ──────────────────────────────────────────────────────── -->

<!-- EMPRÉSTIMOS RECENTES -->
<div class="card">
    <div class="card-header">
        📋 Últimos Empréstimos
        <a href="/Emprestimo" class="btn btn-sm btn-outline" style="margin-left:auto;">Ver todos</a>
    </div>
    <div class="card-body" style="padding:0">
        @if (!Model.EmprestimosRecentes.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">📋</div>
                <h3>Nenhum empréstimo registrado</h3>
                <p>Registre o primeiro empréstimo clicando em "Novo Empréstimo"</p>
            </div>
        }
        else
        {
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Livro</th>
                            <th>Leitor</th>
                            <th>Empréstimo</th>
                            <th>Devolução Prevista</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.EmprestimosRecentes)
                        {
                            <tr>
                                <td><strong>@e.Livro?.Titulo</strong></td>
                                <td><a href="/Leitor/Details/@e.LeitorId" style="color:#2563a8">@e.Leitor?.Nome</a></td>
                                <td>@e.DataEmprestimo.ToString("dd/MM/yyyy")</td>
                                <td>@e.DataPrevistaDevolucao.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (e.Status == "Devolvido")
                                    {
                                        <span class="badge badge-success">Devolvido</span>
                                    }
                                    else if (e.Status == "Atrasado" || e.EstaAtrasado)
                                    {
                                        <span class="badge badge-danger">Atrasado</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-primary">Ativo</span>
                                    }
                                </td>
                                <td>
                                    <a href="/Emprestimo/Details/@e.Id" class="btn btn-sm btn-outline">Detalhes</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
(function () {
    'use strict';

    // ── Dados vindos do Razor (serializados de forma segura) ──────────────────
    var meses          = @Html.Raw(mesesJson);
    var emprestimosMes = @Html.Raw(emprestimosMesJson);
    var devolucoesMes  = @Html.Raw(devolucoesMesJson);
    var categorias     = @Html.Raw(categoriasJson);
    var livrosCateg    = @Html.Raw(livrosCategJson);

    // ── Paleta coerente com o visual do sistema ───────────────────────────────
    var corEmprestimos  = 'rgba(37,  99, 168, 0.85)';   // --primary-light
    var corDevolucoes   = 'rgba(25, 135,  84, 0.75)';   // --success
    var corBordaEmp     = 'rgba(26,  58,  92, 1)';       // --primary
    var corBordaDev     = 'rgba(20, 108,  67, 1)';

    // Paleta de cores para o donut
    var coresPaleta = [
        '#2563a8', '#198754', '#f0a500', '#dc3545',
        '#7c3aed', '#0d9488', '#ea580c', '#0284c7',
        '#65a30d', '#9333ea'
    ];

    // ── Gráfico de Barras ─────────────────────────────────────────────────────
    var canvasBar = document.getElementById('emprestimosChart');
    if (canvasBar) {
        new Chart(canvasBar, {
            type: 'bar',
            data: {
                labels: meses,
                datasets: [
                    {
                        label: 'Emprestados',
                        data: emprestimosMes,
                        backgroundColor: corEmprestimos,
                        borderColor: corBordaEmp,
                        borderWidth: 1,
                        borderRadius: 5,
                        borderSkipped: false
                    },
                    {
                        label: 'Devolvidos',
                        data: devolucoesMes,
                        backgroundColor: corDevolucoes,
                        borderColor: corBordaDev,
                        borderWidth: 1,
                        borderRadius: 5,
                        borderSkipped: false
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: { font: { family: "'Segoe UI', Tahoma, sans-serif", size: 12 } }
                    },
                    tooltip: { mode: 'index', intersect: false }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { font: { family: "'Segoe UI', Tahoma, sans-serif" } }
                    },
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1,
                            precision: 0,
                            font: { family: "'Segoe UI', Tahoma, sans-serif" }
                        },
                        grid: { color: 'rgba(0,0,0,0.05)' }
                    }
                }
            }
        });
    }

    // ── Gráfico Donut ─────────────────────────────────────────────────────────
    var canvasDonut = document.getElementById('categoriasChart');
    if (canvasDonut) {
        var cores = categorias.map(function (_, i) {
            return coresPaleta[i % coresPaleta.length];
        });

        new Chart(canvasDonut, {
            type: 'doughnut',
            data: {
                labels: categorias,
                datasets: [{
                    data: livrosCateg,
                    backgroundColor: cores,
                    borderColor: '#fff',
                    borderWidth: 2,
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            font: { family: "'Segoe UI', Tahoma, sans-serif", size: 11 },
                            padding: 14,
                            usePointStyle: true
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function (ctx) {
                                var total = ctx.dataset.data.reduce(function (a, b) { return a + b; }, 0);
                                var pct = total > 0 ? ((ctx.parsed / total) * 100).toFixed(1) : '0.0';
                                return ' ' + ctx.label + ': ' + ctx.parsed + ' livro(s) (' + pct + '%)';
                            }
                        }
                    }
                }
            }
        });
    }
})();
</script>
}
